# Database
DATABASE_URL=postgresql://user:password@localhost:5432/lifeharness
# For development, you can use SQLite:
# DATABASE_URL=sqlite:///./lifeharness.db

# JWT Secret
SECRET_KEY=your-secret-key-here-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Token Broker (OpenAI-compatible cheap inference) — question generation
TOKENBROKER_API_KEY=tb_your-key-here
TOKENBROKER_API_BASE_URL=https://api.thetokenbroker.ai/v1
TOKENBROKER_MODEL=gemini-3.8-flash

# TypeSafe Jev (decision model) — candidate ranking
TYPESAFE_API_KEY=your-typesafe-key-here
TYPESAFE_API_BASE_URL=https://api.typesafe.ai
JEV_MODEL=jev-latest

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Environment
ENVIRONMENT=development

# Sentry Error Tracking (optional)
# Get DSN from https://sentry.io/ after creating a project
# SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
